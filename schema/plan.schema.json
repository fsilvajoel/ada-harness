{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ada Harness 2.0 Feature Plan",
  "type": "object",
  "required": [
    "schemaVersion",
    "feature",
    "scope",
    "contract",
    "sources",
    "criteria",
    "scenarios",
    "tests",
    "e2e"
  ],
  "properties": {
    "schemaVersion": {"const": 2},
    "feature": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "contract": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["file", "classification"],
        "properties": {
          "file": {"type": "string", "minLength": 1},
          "classification": {
            "enum": ["tdd", "dispensa-estilo", "dispensa-biblioteca"]
          },
          "domain": {"type": "boolean"},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "statement", "source", "layers"],
        "properties": {
          "id": {"pattern": "^A[0-9]+$"},
          "statement": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "layers": {
            "type": "array",
            "minItems": 1,
            "items": {"enum": ["unit", "prop", "e2e", "mut", "visual"]}
          }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "criterion", "layer", "file", "input", "expected", "source"],
        "properties": {
          "id": {"pattern": "^C[0-9]+$"},
          "criterion": {"pattern": "^A[0-9]+$"},
          "layer": {"enum": ["unit", "prop", "e2e", "visual"]},
          "file": {"type": "string", "minLength": 1},
          "input": {"type": "string", "minLength": 1},
          "expected": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1}
        }
      }
    },
    "tests": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "e2e": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "decisions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "openQuestions": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false
}
