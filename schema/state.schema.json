{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ada Harness Feature State",
  "type": "object",
  "required": ["schemaVersion", "feature", "sources", "domainSources", "exemptSources", "criteria", "tests", "e2e", "scenarios"],
  "properties": {
    "schemaVersion": {"const": 2},
    "feature": {"type": "string", "minLength": 1},
    "sources": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "domainSources": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "exemptSources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "class", "reason"],
        "properties": {
          "file": {"type": "string", "minLength": 1},
          "class": {"enum": ["dispensa-estilo", "dispensa-biblioteca"]},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "camadas"],
        "properties": {
          "id": {"pattern": "^A[0-9]+$"},
          "camadas": {
            "type": "array",
            "minItems": 1,
            "items": {"enum": ["unit", "prop", "e2e", "mut"]}
          }
        }
      }
    },
    "tests": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "e2e": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "criterio", "camada", "arquivo", "teste"],
        "properties": {
          "id": {"pattern": "^C[0-9]+$"},
          "criterio": {"pattern": "^A[0-9]+$"},
          "camada": {"enum": ["unit", "prop", "e2e"]},
          "arquivo": {"type": "string", "minLength": 1},
          "teste": {"type": "string", "minLength": 1}
        }
      }
    },
    "testShas": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
    }
  },
  "additionalProperties": true
}
