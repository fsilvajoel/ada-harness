{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ada Harness Feature Execution Contract",
  "description": "Contrato versionado gerado por script/feature_contract.py e consumido por script/run_feature.py. A validação canônica (referências, ciclos, config) é lint_contract.",
  "type": "object",
  "required": [
    "schemaVersion", "feature", "sdd", "plan", "cards", "cardOrder", "gates", "configSha256", "stages", "needsInput"
  ],
  "additionalProperties": false,
  "$defs": {
    "ref": {
      "type": "object",
      "required": ["path", "sha256"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "minLength": 1, "not": {"pattern": "(^/|\\\\|(^|/)\\.\\.(/|$))"}},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "pathList": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "not": {"pattern": "(^/|\\\\|(^|/)\\.\\.(/|$))"}}
    }
  },
  "properties": {
    "schemaVersion": {"const": 1},
    "feature": {"type": "string", "pattern": "^[A-Za-z0-9_-]+-F[0-9]+$"},
    "sdd": {
      "type": "object",
      "required": ["prd", "adr", "rfc"],
      "additionalProperties": false,
      "properties": {
        "prd": {"$ref": "#/$defs/ref"},
        "adr": {"$ref": "#/$defs/ref"},
        "rfc": {"$ref": "#/$defs/ref"}
      }
    },
    "plan": {"$ref": "#/$defs/ref"},
    "cards": {"$ref": "#/$defs/ref"},
    "cardOrder": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "dependsOn"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["docs", "implement", "pre-review", "test-author"]},
          "dependsOn": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "gates": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "configSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stages": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": [
          "stage", "role", "executorChain", "maxAttempts", "request", "gate", "timeoutS", "allowedPaths",
          "skills", "mode", "cards", "applicable"
        ],
        "additionalProperties": false,
        "properties": {
          "stage": {"enum": ["refinement", "tests", "testReview", "implement", "mutation_e2e", "finalReview", "closing"]},
          "role": {"type": "string", "minLength": 1},
          "executorChain": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "maxAttempts": {"type": "integer", "minimum": 1},
          "request": {"$ref": "#/$defs/ref"},
          "gate": {"type": "string", "minLength": 1},
          "timeoutS": {"type": "integer", "minimum": 1},
          "allowedPaths": {"$ref": "#/$defs/pathList"},
          "skills": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "mode": {"enum": ["read", "write"]},
          "cards": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "applicable": {"type": "boolean"},
          "stubPaths": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "stageSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "needsInput": {
      "type": "object",
      "required": ["questionsFile", "planApproval"],
      "additionalProperties": false,
      "properties": {
        "questionsFile": {"const": "questions.json"},
        "planApproval": {"const": true}
      }
    }
  }
}
